<Window x:Class="Poster.CurlImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import cURL Command"
        Width="560" Height="320"
        MinWidth="400" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Left" Padding="6,2" Click="OnPasteClicked">
        Paste from _Clipboard
      </Button>
      <Button DockPanel.Dock="Right" Width="80" Margin="6,0,0,0"
              IsCancel="True" Click="OnCancelClicked">
        _Cancel
      </Button>
      <Button DockPanel.Dock="Right" Width="80"
              IsDefault="True" Click="OnOkClicked">
        _OK
      </Button>
      <!-- filler -->
      <Border />
    </DockPanel>
    <TextBox x:Name="curlInput"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Padding="4"
             FontFamily="Consolas"
             SpellCheck.IsEnabled="False" />
  </DockPanel>
</Window>
